# ================================================================
# Invoice Validation AI Agent - Docker-free Supabase configuration
# Copy this file to .env and replace placeholder values.
# ================================================================

# ---------- Supabase PostgreSQL ----------
# Recommended for a laptop on an IPv4 network: Supabase "Session pooler" URL
# from Dashboard -> Connect. You may paste postgresql:// directly; the app
# automatically selects the psycopg v3 SQLAlchemy driver.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# ---------- Supabase private invoice storage ----------
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# BACKEND ONLY. Current Supabase projects should use an sb_secret_... key.
# Never expose this value with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY
# Legacy projects may instead set SUPABASE_SERVICE_ROLE_KEY; leave empty normally.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=invoices

# ---------- AI ----------
# Start with mock while learning/testing. Switch to openai for the hackathon.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ---------- Validation policy ----------
PRICE_TOLERANCE_PERCENT=0.0
QUANTITY_TOLERANCE_PERCENT=0.0
AUTO_APPROVE_MAX_RISK=19

# ---------- Browser / API ----------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
